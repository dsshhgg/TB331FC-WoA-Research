        /*
         * QUFN..MUXC (15 Name objects) stood here.  They were the global
         * state of the USB role-switch container (URS0) that the tapas
         * DSDT flattened away; nothing in this table references them.
         * Removed -- iasl reports no unresolved reference.
         */

        Device (USB0)
        {
            Name (_HID, "PNP0D10" /* XHCI USB Controller with debug */)  // _HID: Hardware ID
            Name (_CID, "PNP0D10" /* XHCI USB Controller with debug */)  // _CID: Compatible ID
            Name (_UID, Zero)  // _UID: Unique ID
            Name (_CCA, Zero)  // _CCA: Cache Coherency Attribute
            Name (_S0W, Zero)  // _S0W: S0 Device Wake State
            Name (_DDN, "Qualcomm DWC3 xHCI controller (PNP0D10)")  // _DDN: Descriptive Name
            Name (_CRS, ResourceTemplate ()  // _CRS: Current Resource Settings
            {
                Memory32Fixed (ReadWrite,
                    0x04E00000,         // Address Base
                    0x000FFFFF,         // Address Length
                    )
                Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive, ,, )
                {
                    0x0000011F,
                }
            })
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                Return (0x0F)
            }
        }

        Device (GPU0)
        {
            Name (_HID, "TPZG0610")  // _HID: Hardware ID
            Name (_UID, Zero)  // _UID: Unique ID
            Name (_CCA, Zero)  // _CCA: Cache Coherency Attribute
            Name (_DDN, "Qualcomm Adreno 610 GPU (TPZG0610)")  // _DDN: Descriptive Name
            Name (_CRS, ResourceTemplate ()  // _CRS: Current Resource Settings
            {
                Memory32Fixed (ReadWrite,
                    0x05900000,         // Address Base
                    0x00090000,         // Address Length
                    )
                Interrupt (ResourceConsumer, Level, ActiveHigh, Exclusive, ,, )
                {
                    0x000000D1,
                }
            })
            Name (GPUE, One)
            Method (_STA, 0, NotSerialized)  // _STA: Status
            {
                If (GPUE)
                {
                    Return (0x0F)
                }

                Return (Zero)
            }
        }
